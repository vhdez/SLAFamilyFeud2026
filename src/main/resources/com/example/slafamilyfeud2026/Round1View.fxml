        <Label fx:id="score6" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="5" />

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="7" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <Label fx:id="answer7" alignment="CENTER" prefHeight="50" prefWidth="370" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        <Label fx:id="score7" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="6" />

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="8" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <Label fx:id="answer8" alignment="CENTER" prefHeight="50" prefWidth="370" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        <Label fx:id="score8" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="7" />

    </GridPane>

</AnchorPane>
