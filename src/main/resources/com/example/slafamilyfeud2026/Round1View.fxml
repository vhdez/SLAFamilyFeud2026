<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.slafamilyfeud2026.Round1Controller">

    <ImageView fx:id="backgroundImage" fitHeight="600" fitWidth="800" preserveRatio="false" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" />

    <HBox prefWidth="800" spacing="0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="20">

        <Label fx:id="team1Score" alignment="CENTER" prefHeight="40" prefWidth="250" style="-fx-border-color: black; -fx-border-width: 1;" text="Team 1: 0" />

        <Label fx:id="roundScore" alignment="CENTER" prefHeight="40" prefWidth="300" style="-fx-border-color: black; -fx-border-width: 1;" text="Round: 0" />

        <Label fx:id="team2Score" alignment="CENTER" prefHeight="40" prefWidth="250" style="-fx-border-color: black; -fx-border-width: 1;" text="Team 2: 0" />

    </HBox>


    <GridPane fx:id="answersGrid" AnchorPane.leftAnchor="150" AnchorPane.topAnchor="80">

        <columnConstraints>
            <ColumnConstraints prefWidth="30" />
            <ColumnConstraints prefWidth="370" />
            <ColumnConstraints prefWidth="100" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
            <RowConstraints prefHeight="50" />
        </rowConstraints>

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="answer1" alignment="CENTER" prefHeight="50" prefWidth="370" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label fx:id="score1" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="2" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="answer2" alignment="CENTER" prefHeight="50" prefWidth="370" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label fx:id="score2" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="1" />

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="3" GridPane.columnIndex="0" GridPane.rowIndex="2" />
