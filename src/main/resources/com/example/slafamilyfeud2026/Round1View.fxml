        <Label fx:id="score4" alignment="CENTER" prefHeight="50" prefWidth="100" style="-fx-border-color: black; -fx-border-width: 1;" text="" GridPane.columnIndex="2" GridPane.rowIndex="3" />

        <Label alignment="CENTER" prefHeight="50" prefWidth="30" style="-fx-border-color: black; -fx-border-width: 1;" text="5" GridPane.columnIndex="0" GridPane.rowIndex="4" />
